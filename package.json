{
    "name": "grafana-yamcs-jaops",
    "version": "1.1.0",
    "scripts": {
        "build": "webpack -c ./webpack.config.ts --env production",
        "dev": "webpack -w -c ./webpack.config.ts --env development",
        "test": "jest --watch --onlyChanged",
        "test:backend": "go test ./pkg/...",
        "test:ci": "jest --passWithNoTests --maxWorkers 4",
        "test:integration:yamcs": "go test -tags=integration ./pkg/yamcs/client/integration -run Integration -v -count=1",
        "typecheck": "tsc --noEmit",
        "lint": "eslint --cache .",
        "lint:fix": "pnpm run lint --fix && prettier --write --list-different .",
        "e2e": "playwright test --grep-invert @benchmark",
        "bench:simulator": "python3 scripts/benchmarks/simulator/run.py",
        "bench:micro": "python3 scripts/benchmarks/micro/run.py",
        "bench:report": "python3 scripts/benchmarks/report.py",
        "server": "docker compose up --build",
        "server:dev": "DEVELOPMENT=true docker compose up --build",
        "server:localhost": "docker compose up --build",
        "server:nginx": "docker compose -f docker-compose-nginx.yaml up --build",
        "sign": "npx --yes @grafana/sign-plugin@latest",
        "bench:grafana": "playwright test tests/benchmark/streaming.benchmark.spec.ts --project=chromium"
    },
    "author": "Jaops",
    "license": "MIT",
    "devDependencies": {
        "@grafana/eslint-config": "^10.0.0",
        "@grafana/plugin-e2e": "^3.10.0",
        "@grafana/tsconfig": "^2.2.0",
        "@playwright/test": "^1.61.0",
        "@stylistic/eslint-plugin-ts": "^4.4.1",
        "@swc/core": "^1.15.41",
        "@swc/helpers": "^0.5.23",
        "@swc/jest": "^0.2.39",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.2",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.0.0",
        "@types/react": "18",
        "@types/react-dom": "18",
        "@typescript-eslint/eslint-plugin": "^8.61.1",
        "@typescript-eslint/parser": "^8.61.1",
        "@typescript-eslint/typescript-estree": "^8.61.1",
        "@typescript-eslint/utils": "^8.61.1",
        "copy-webpack-plugin": "^14.0.0",
        "css-loader": "^7.1.4",
        "eslint": "^9.30.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^63.0.6",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-webpack-plugin": "^6.0.0",
        "fork-ts-checker-webpack-plugin": "^9.1.0",
        "glob": "^13.0.6",
        "identity-obj-proxy": "3.0.0",
        "imports-loader": "^5.0.0",
        "jest": "^30.4.2",
        "jest-environment-jsdom": "^30.4.1",
        "prettier": "^3.8.4",
        "replace-in-file-webpack-plugin": "^1.0.6",
        "sass": "1.101.0",
        "sass-loader": "17.0.0",
        "semver": "^7.8.4",
        "style-loader": "4.0.0",
        "swc-loader": "^0.2.7",
        "terser-webpack-plugin": "^5.6.1",
        "ts-node": "^10.9.2",
        "typescript": "5.9.2",
        "webpack": "^5.107.2",
        "webpack-cli": "^7.0.3",
        "webpack-livereload-plugin": "^3.0.2",
        "webpack-merge": "^6.0.1",
        "webpack-subresource-integrity": "5.2.0-rc.1",
        "webpack-virtual-modules": "^0.6.2"
    },
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "@emotion/css": "11.13.5",
        "@grafana/data": "^13.1.3",
        "@grafana/runtime": "^13.1.3",
        "@grafana/schema": "^13.1.3",
        "@grafana/ui": "^13.1.3",
        "@testing-library/user-event": "^14.6.4",
        "date-fns": "^4.4.0",
        "dompurify": "^3.4.13",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "react-router-dom": "^7.18.2",
        "rxjs": "7.8.2"
    },
    "packageManager": "pnpm@10.28.1"
}
